# Copy this file to `.env` and fill in your real keys before running the app.
# `.env` is bundled as a Flutter asset (see pubspec.yaml), so it must exist -
# a blank/placeholder `.env` is committed so the app still builds without it.
#
# IMPORTANT: `.env` is intentionally tracked in git (with blank placeholder
# values) so a fresh clone always builds. Once you fill in real secrets,
# protect them from ever being committed by telling git to ignore local
# changes to this one file (run this once per machine):
#   git update-index --skip-worktree .env
# (To undo: git update-index --no-skip-worktree .env)

# Mixpanel (https://mixpanel.com -> Project Settings -> Access Keys -> Project Token)
MIXPANEL_TOKEN=

# Superwall (https://superwall.com -> App Settings -> API Keys)
SUPERWALL_API_KEY_IOS=
SUPERWALL_API_KEY_ANDROID=
# The placement/trigger name configured in your Superwall dashboard campaign.
SUPERWALL_PAYWALL_PLACEMENT=campaign_trigger
